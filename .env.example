# Copie para .env:  cp .env.example .env
# Arquivo único compartilhado entre a aplicação (pydantic-settings) e o Docker Compose.

APP_NAME=open-steamid-locator

# Porta exposta no host (o container sempre escuta em 8000 internamente)
PORT=8000

# Padrão de desenvolvimento. Em produção use false: com debug ligado, um erro não
# tratado devolve a página de traceback do Starlette, expondo código e variáveis.
DEBUG=true

# Steam Web API — obtenha em https://steamcommunity.com/dev/apikey
# Vazia: a busca ainda converte SteamID (aritmética pura), mas não traz dados de
# perfil e não resolve vanity URL.
STEAM_API_KEY=
